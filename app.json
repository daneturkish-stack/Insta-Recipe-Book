{
  "expo": {
    "name": "Kitch",
    "slug": "kitch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kitch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitch.app",
      "associatedDomains": ["applinks:kitch.replit.app"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F8F4",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kitch.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/reel"
            },
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "*.tiktok.com"
            },
            {
              "scheme": "https",
              "host": "vm.tiktok.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F8F4",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
