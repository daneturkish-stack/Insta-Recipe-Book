{
  "expo": {
    "name": "Simmer",
    "slug": "kitch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simmer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danevanzyl.simmer",
      "appleTeamId": "9XF8U86QB2",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Simmer connects to your local development server while testing.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_http._tcp"
        ]
      }
    },
    "android": {
      "package": "com.danevanzyl.simmer",
      "adaptiveIcon": {
        "backgroundColor": "#F9F8F4",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/reel"
            },
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "*.tiktok.com"
            },
            {
              "scheme": "https",
              "host": "vm.tiktok.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F8F4",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "@bacons/apple-targets",
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8bb6a0c2-4e86-4cd9-abe5-7589eddff872"
      }
    }
  }
}
